local Config = {
    Enabled = true,

    Rainbow = true,
    Camera360 = true,
    PlayerHighlights = true,
    Bloom = true,

    RotationSpeed = 25,
    RainbowSpeed = 0.12,
}

local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local env = getgenv()

-- Zatrzymaj poprzednią wersję
if env.StopLSDVisuals then
    env.StopLSDVisuals()
end

local oldCameraName = "LSD_Visual_Update"
RunService:UnbindFromRenderStep(oldCameraName)

local color = Instance.new("ColorCorrectionEffect")
color.Name = "LSD_Rainbow"
color.Saturation = 0.8
color.Contrast = 0.15
color.Parent = Lighting

local bloom = Instance.new("BloomEffect")
bloom.Name = "LSD_Bloom"
bloom.Intensity = 0.6
bloom.Size = 24
bloom.Threshold = 1
bloom.Parent = Lighting

local highlights = {}
local connections = {}
local elapsed = 0
local angle = 0
local running = true

local function removeHighlight(character)
    local highlight = highlights[character]
    if highlight then
        highlight:Destroy()
        highlights[character] = nil
    end
end

local function addHighlight(character)
    if not character or highlights[character] then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "LSD_Player"
    highlight.FillTransparency = 0.45
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    highlights[character] = highlight
end

local function stop()
    if not running then return end
    running = false
    Config.Enabled = false

    RunService:UnbindFromRenderStep(oldCameraName)

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    for character in pairs(highlights) do
        removeHighlight(character)
    end

    color:Destroy()
    bloom:Destroy()
end

env.LSDConfig = Config
env.StopLSDVisuals = stop

table.insert(connections, Players.PlayerAdded:Connect(function(other)
    table.insert(connections, other.CharacterAdded:Connect(function(character)
        if Config.Enabled and Config.PlayerHighlights then
            addHighlight(character)
        end
    end))
end))

for _, other in ipairs(Players:GetPlayers()) do
    if other ~= player then
        if other.Character then
            addHighlight(other.Character)
        end

        table.insert(connections, other.CharacterAdded:Connect(function(character)
            if Config.Enabled and Config.PlayerHighlights then
                addHighlight(character)
            end
        end))
    end
end

RunService:BindToRenderStep(
    oldCameraName,
    Enum.RenderPriority.Camera.Value + 1,
    function(dt)
        if not Config.Enabled then
            stop()
            return
        end

        elapsed += dt

        local hue = (elapsed * Config.RainbowSpeed) % 1

        -- Rainbow
        color.Enabled = Config.Rainbow
        if Config.Rainbow then
            color.TintColor = Color3.fromHSV(hue, 0.65, 1)
        end

        -- Bloom
        bloom.Enabled = Config.Bloom

        -- Camera 360
        if Config.Camera360 then
            angle = (angle + dt * math.rad(Config.RotationSpeed))
                % (math.pi * 2)

            local camera = workspace.CurrentCamera
            if camera then
                camera.CFrame = camera.CFrame
                    * CFrame.Angles(0, 0, angle)
            end
        else
            angle = 0
        end

        -- Player highlights
        for character, highlight in pairs(highlights) do
            if not character.Parent then
                removeHighlight(character)
            else
                highlight.Enabled = Config.PlayerHighlights

                if Config.PlayerHighlights then
                    highlight.FillColor = Color3.fromHSV(
                        (hue + 0.25) % 1, 0.8, 1
                    )
                    highlight.OutlineColor = Color3.fromHSV(
                        (hue + 0.65) % 1, 1, 1
                    )
                end
            end
        end
    end
)

print("LSD Visuals loaded")
